# URL de base de l'API Ocelot (ex. https://ocelot.staging.mo5.fr)
OCLOT_API_URL=

# Clé d'API si l'API Ocelot l'exige côté serveur (optionnel)
OCLOT_API_KEY=

# Zitadel — mêmes variables qu'Ocelot staging
ZITADEL_ISSUER=
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=
# URL de rappel OIDC (défaut : http://localhost:3000/api/auth/callback)
# ZITADEL_REDIRECT_URI=
# Scopes OIDC (défaut : openid profile email offline_access urn:zitadel:iam:org:project:roles)
# ZITADEL_SCOPES=
# Claim portant les rôles (défaut : urn:zitadel:iam:org:project:roles)
# ZITADEL_ROLES_CLAIM=

# Domaine des cookies de session en production (optionnel)
# COOKIE_DOMAIN=
# Durée du jeton de rafraîchissement en jours (défaut : 90)
# REFRESH_TOKEN_MAX_AGE_DAYS=
